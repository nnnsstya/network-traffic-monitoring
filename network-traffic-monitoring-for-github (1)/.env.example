# По умолчанию проект НЕ отправляет сетевые запросы в сторонние сервисы.
# Для отправки одновременно нужны: переменная ниже =1 и --live при запуске.
ALLOW_EXTERNAL_CALLS=0

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack
SLACK_WEBHOOK_URL=

# Биометрия: URL доверенного сервиса сверки assertion; контракт примерный
BIOMETRIC_VERIFY_URL=
BIOMETRIC_API_KEY=

# AWS: стандартный SDK credential chain / AWS CLI или роль IAM
AWS_REGION=

# Azure: сначала создать DCR и таблицу в Log Analytics
AZURE_LOG_ENDPOINT=
AZURE_DCR_ID=
AZURE_STREAM_NAME=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# MISP, AlienVault OTX
MISP_URL=
MISP_API_KEY=
OTX_API_KEY=
